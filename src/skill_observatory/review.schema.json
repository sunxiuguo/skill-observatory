{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skill-observatory:review:v1",
  "title": "Review receipt proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "run_id", "skill_id", "skill_package_sha256", "attribution", "coverage", "outcome", "findings", "decision", "missing", "evidence_manifest_sha256", "reviewer_version"],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "skill_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "skill_package_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "attribution": {"enum": ["explicit_loaded", "verified_read", "executed_script", "inferred", "unknown"]},
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["tools", "outcome"],
      "properties": {
        "tools": {"enum": ["complete_in_declared_scope", "partial", "unknown"]},
        "outcome": {"enum": ["verified", "partial", "unverified"]}
      }
    },
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source"],
      "properties": {
        "status": {"enum": ["accepted", "partial", "failed", "unverified"]},
        "source": {"enum": ["artifact_verifier", "user_acceptance", "domain_oracle", "runtime_only", "unknown"]}
      }
    },
    "findings": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "owner_kind", "severity", "evidence_ids", "fingerprint", "expected_code", "observed_code", "root_cause", "confidence", "action"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "category": {"enum": ["missing_procedure", "incorrect_procedure", "rule_violation", "environment_drift", "implementation_defect", "insufficient_evidence", "supported_success"]},
          "owner_kind": {"enum": ["skill", "project", "environment", "runtime", "unknown"]},
          "severity": {"enum": ["low", "medium", "high", "critical"]},
          "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "fingerprint": {"$ref": "#/$defs/sha256"},
          "rule_ref": {"type": ["string", "null"], "maxLength": 240},
          "expected_code": {"$ref": "#/$defs/code"},
          "observed_code": {"$ref": "#/$defs/code"},
          "root_cause": {"type": "string", "maxLength": 480},
          "confidence": {"enum": ["supported", "tentative", "unknown"]},
          "action": {"enum": ["no_change", "project_fix", "environment_recovery", "execution_fix", "propose_replacement", "collect_evidence"]}
        }
      }
    },
    "decision": {"enum": ["NO_CHANGE", "PROJECT_ONLY", "CANDIDATE", "HOLD"]},
    "missing": {"type": "array", "uniqueItems": true, "items": {"type": "string", "maxLength": 160}},
    "evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_version": {"$ref": "#/$defs/id"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,95}$"}
  }
}
